{
  "name": "axex-orbit",
  "version": "0.1.0",
  "description": "Axex Orbit - Track & Tap temporal captcha for high-risk Discord verification",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "redteam": "node tools/redteam.js",
    "lint": "node --check src/*.js sdk/*.js tools/*.js",
    "check": "npm run lint && npm test",
    "testSecurity": "node --test test/security.test.js",
    "testA11y": "node --test test/a11y.test.js",
    "audit": "npm audit --omit=dev",
    "load": "node tools/load-smoke.js"
  },
  "license": "MIT",
  "private": false,
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  }
}
