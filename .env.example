# Axex Orbit production configuration
# Generate secrets with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=8787
TRUST_PROXY=0
ORBIT_SIGNING_KEY=
ORBIT_SIGNING_KEY_ID=k1
ORBIT_PREVIOUS_SIGNING_KEYS=
ORBIT_SITE_SECRET=
ORBIT_PREVIOUS_SITE_SECRETS=
ORBIT_PUBLIC_URL=https://orbit.example
ALLOWED_ORIGINS=https://your-portal.example
DATABASE_URL=postgresql://orbit:CHANGE_ME@db.example:5432/orbit?sslmode=require
PG_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=5000
MIN_BEHAVIOR=0.5
ORBIT_METRICS_ENABLED=0
LOG_LEVEL=info
