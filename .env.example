# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ORBIT_SIGNING_KEY=
ORBIT_SITE_SECRET=
# Comma-separated origins allowed to embed the widget (your portal). Required for the iframe to load.
ALLOWED_ORIGINS=https://your-portal.example
# Optional: Postgres/Neon for replay protection shared across instances. Without it, in-memory (single instance only).
DATABASE_URL=
PORT=8787
# Set to 1 only when running behind a reverse proxy you trust (Railway/Render/Fly), so rate limits use the real client IP.
TRUST_PROXY=1
# Minimum behavior score (0..1) to accept an answer. Tune on real traces.
MIN_BEHAVIOR=0.5
